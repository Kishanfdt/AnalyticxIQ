{
  "name": "analyticiq-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AnalyticxIQ - Sales Analytics Platform Monorepo Root",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "dev:shared": "npm run dev --workspace=shared",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:shared": "npm run build --workspace=shared",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build:backend": "npm run build:shared && npm run build:server",
    "start:backend": "npm run start --workspace=server",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "typescript": "^5.2.2",
    "typescript-eslint": "^7.5.0"
  }
}

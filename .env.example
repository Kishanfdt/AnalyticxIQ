# Database connection string (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Server configuration
PORT=5000
NODE_ENV="development" # development, production, test
JWT_SECRET="your_jwt_secret_key"

# CORS — comma-separated list of allowed frontend origins (production only)
CORS_ORIGIN="https://your-app.vercel.app"
